<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Announcements Manager | Smart Campus Admin</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        :root {
            --primary: #1a3a5c;
            --secondary: #e8a735;
            --success: #27ae60;
            --danger: #e74c3c;
            --warning: #f39c12;
            --info: #3498db;
            --light: #f8f9fa;
            --white: #ffffff;
            --shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }

        .navbar {
            background: var(--white);
            box-shadow: var(--shadow);
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: bold;
            color: var(--primary);
        }

        .logo span { color: var(--secondary); }

        .container {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 2rem;
        }

        .card {
            background: var(--white);
            border-radius: 12px;
            box-shadow: var(--shadow);
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .card-title {
            color: var(--primary);
            margin-bottom: 1.5rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid var(--secondary);
        }

        .form-group {
            margin-bottom: 1rem;
        }

        label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--primary);
            font-weight: 500;
        }

        input, select, textarea {
            width: 100%;
            padding: 0.75rem;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 1rem;
        }

        .btn {
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s;
        }

        .btn-primary { background: var(--secondary); color: white; }
        .btn-danger { background: var(--danger); color: white; }
        .btn-success { background: var(--success); color: white; }

        .announcement-item {
            background: var(--light);
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 1rem;
            transition: all 0.3s;
        }

        .announcement-item:hover { transform: translateX(5px); }

        .priority-high { border-left: 4px solid var(--danger); }
        .priority-medium { border-left: 4px solid var(--warning); }
        .priority-low { border-left: 4px solid var(--info); }

        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .stat-box {
            background: linear-gradient(135deg, var(--primary), var(--info));
            color: white;
            padding: 1rem;
            border-radius: 8px;
            text-align: center;
        }

        .back-link {
            display: inline-block;
            margin-bottom: 1rem;
            color: var(--secondary);
            text-decoration: none;
        }

        @media (max-width: 768px) {
            .container { padding: 0 1rem; }
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="logo">Smart<span>Campus</span> Announcements</div>
        <div>
            <span>Admin: <%= user.name %></span>
            <button class="btn" style="background: var(--danger); color: white; margin-left: 1rem;" onclick="logout()">Logout</button>
        </div>
    </nav>

    <div class="container">
        <a href="/dashboard/admin" class="back-link">← Back to Dashboard</a>

        <div class="stats">
            <div class="stat-box">
                <h3 id="totalCount">0</h3>
                <p>Total Announcements</p>
            </div>
            <div class="stat-box">
                <h3 id="activeCount">0</h3>
                <p>Active Announcements</p>
            </div>
            <div class="stat-box">
                <h3 id="urgentCount">0</h3>
                <p>Urgent Priority</p>
            </div>
        </div>

        <div class="card">
            <h2 class="card-title">📢 Create New Announcement</h2>
            <form id="announcementForm">
                <div class="form-group">
                    <label>Title *</label>
                    <input type="text" id="title" required placeholder="Enter announcement title">
                </div>
                <div class="form-group">
                    <label>Content *</label>
                    <textarea id="content" rows="4" required placeholder="Write announcement content..."></textarea>
                </div>
                <div class="form-group">
                    <label>Priority</label>
                    <select id="priority">
                        <option value="Low">🔵 Low</option>
                        <option value="Medium">🟡 Medium</option>
                        <option value="High">🟠 High</option>
                        <option value="Urgent">🔴 Urgent</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Category</label>
                    <select id="category">
                        <option>Academic</option>
                        <option>Event</option>
                        <option>General</option>
                        <option>Emergency</option>
                        <option>Holiday</option>
                        <option>Exam</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Expiry Date (Optional)</label>
                    <input type="date" id="expiresAt">
                </div>
                <button type="submit" class="btn btn-primary">Publish Announcement</button>
            </form>
        </div>

        <div class="card">
            <h2 class="card-title">📋 All Announcements</h2>
            <div id="announcementsList"></div>
        </div>
    </div>

    <script>
        let allAnnouncements = [];

        document.addEventListener('DOMContentLoaded', () => {
            loadAnnouncements();
        });

        async function loadAnnouncements() {
            try {
                const response = await fetch('/announcements/all');
                const data = await response.json();
                if (data.success) {
                    allAnnouncements = data.announcements;
                    updateStats();
                    displayAnnouncements();
                }
            } catch (error) {
                console.error('Error:', error);
            }
        }

        function updateStats() {
            document.getElementById('totalCount').innerHTML = allAnnouncements.length;
            document.getElementById('activeCount').innerHTML = allAnnouncements.filter(a => a.isActive).length;
            document.getElementById('urgentCount').innerHTML = allAnnouncements.filter(a => a.priority === 'Urgent' && a.isActive).length;
        }

        function displayAnnouncements() {
            const container = document.getElementById('announcementsList');
            if (allAnnouncements.length === 0) {
                container.innerHTML = '<p>No announcements yet. Create your first announcement above.</p>';
                return;
            }

            container.innerHTML = allAnnouncements.map(ann => `
                <div class="announcement-item priority-${ann.priority.toLowerCase()}">
                    <div style="display: flex; justify-content: space-between; align-items: start;">
                        <div style="flex: 1;">
                            <h3>${escapeHtml(ann.title)}</h3>
                            <span class="badge" style="background: ${getPriorityColor(ann.priority)}; color: white; padding: 2px 8px; border-radius: 4px; font-size: 12px;">${ann.priority}</span>
                            <span class="badge" style="background: #3498db; color: white; padding: 2px 8px; border-radius: 4px; font-size: 12px;">${ann.category}</span>
                            <p style="margin-top: 0.5rem;">${escapeHtml(ann.content)}</p>
                            <small>Created: ${new Date(ann.createdAt).toLocaleString()}</small>
                            ${ann.expiresAt ? `<small> | Expires: ${new Date(ann.expiresAt).toLocaleDateString()}</small>` : ''}
                        </div>
                        <div>
                            <button class="btn btn-success" style="padding: 0.25rem 0.75rem;" onclick="editAnnouncement('${ann._id}')">Edit</button>
                            <button class="btn btn-danger" style="padding: 0.25rem 0.75rem;" onclick="deleteAnnouncement('${ann._id}')">Delete</button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        document.getElementById('announcementForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const data = {
                title: document.getElementById('title').value,
                content: document.getElementById('content').value,
                priority: document.getElementById('priority').value,
                category: document.getElementById('category').value,
                expiresAt: document.getElementById('expiresAt').value || null
            };
            
            try {
                const response = await fetch('/announcements/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                
                const result = await response.json();
                if (result.success) {
                    alert('Announcement published successfully!');
                    document.getElementById('announcementForm').reset();
                    loadAnnouncements();
                } else {
                    alert('Error: ' + result.message);
                }
            } catch (error) {
                alert('Error: ' + error.message);
            }
        });

        async function deleteAnnouncement(id) {
            if (confirm('Are you sure you want to delete this announcement?')) {
                try {
                    const response = await fetch(`/announcements/${id}`, { method: 'DELETE' });
                    const result = await response.json();
                    if (result.success) {
                        alert('Announcement deleted!');
                        loadAnnouncements();
                    }
                } catch (error) {
                    alert('Error: ' + error.message);
                }
            }
        }

        async function editAnnouncement(id) {
            const newTitle = prompt('Enter new title:');
            if (!newTitle) return;
            const newContent = prompt('Enter new content:');
            if (!newContent) return;
            
            try {
                const response = await fetch(`/announcements/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title: newTitle, content: newContent })
                });
                
                const result = await response.json();
                if (result.success) {
                    alert('Announcement updated!');
                    loadAnnouncements();
                }
            } catch (error) {
                alert('Error: ' + error.message);
            }
        }

        function getPriorityColor(priority) {
            const colors = { 'Low': '#3498db', 'Medium': '#f39c12', 'High': '#e67e22', 'Urgent': '#e74c3c' };
            return colors[priority] || '#95a5a6';
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function logout() { window.location.href = '/logout'; }
    </script>
</body>
</html>