<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Events Manager | Smart Campus Admin</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        :root {
            --primary: #1a3a5c;
            --secondary: #e8a735;
            --success: #27ae60;
            --danger: #e74c3c;
            --info: #3498db;
            --light: #f8f9fa;
            --white: #ffffff;
            --shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }

        .navbar {
            background: var(--white);
            box-shadow: var(--shadow);
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: bold;
            color: var(--primary);
        }

        .logo span { color: var(--secondary); }

        .container {
            max-width: 1400px;
            margin: 2rem auto;
            padding: 0 2rem;
        }

        .card {
            background: var(--white);
            border-radius: 12px;
            box-shadow: var(--shadow);
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .card-title {
            color: var(--primary);
            margin-bottom: 1.5rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid var(--secondary);
        }

        .form-group {
            margin-bottom: 1rem;
        }

        label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--primary);
            font-weight: 500;
        }

        input, select, textarea {
            width: 100%;
            padding: 0.75rem;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 1rem;
        }

        .btn {
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s;
        }

        .btn-primary { background: var(--secondary); color: white; }
        .btn-danger { background: var(--danger); color: white; }
        .btn-info { background: var(--info); color: white; }

        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .stat-box {
            background: linear-gradient(135deg, var(--primary), var(--info));
            color: white;
            padding: 1rem;
            border-radius: 8px;
            text-align: center;
        }

        .event-card {
            background: var(--light);
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 1rem;
            transition: all 0.3s;
        }

        .event-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }

        .event-header {
            display: flex;
            justify-content: space-between;
            align-items: start;
        }

        .seats-info {
            display: inline-block;
            padding: 0.25rem 0.5rem;
            border-radius: 4px;
            font-size: 0.85rem;
        }

        .seats-available { background: var(--success); color: white; }
        .seats-full { background: var(--danger); color: white; }

        .back-link {
            display: inline-block;
            margin-bottom: 1rem;
            color: var(--secondary);
            text-decoration: none;
        }

        @media (max-width: 768px) {
            .container { padding: 0 1rem; }
            .event-header { flex-direction: column; }
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="logo">Smart<span>Campus</span> Events</div>
        <div>
            <span>Admin: <%= user.name %></span>
            <button class="btn" style="background: var(--danger); color: white; margin-left: 1rem;" onclick="logout()">Logout</button>
        </div>
    </nav>

    <div class="container">
        <a href="/dashboard/admin" class="back-link">← Back to Dashboard</a>

        <div class="stats">
            <div class="stat-box">
                <h3 id="totalEvents">0</h3>
                <p>Total Events</p>
            </div>
            <div class="stat-box">
                <h3 id="upcomingEvents">0</h3>
                <p>Upcoming Events</p>
            </div>
            <div class="stat-box">
                <h3 id="totalRegistrations">0</h3>
                <p>Total Registrations</p>
            </div>
        </div>

        <div class="card">
            <h2 class="card-title">🎉 Create New Event</h2>
            <form id="eventForm">
                <div class="form-group">
                    <label>Event Title *</label>
                    <input type="text" id="title" required placeholder="Enter event title">
                </div>
                <div class="form-group">
                    <label>Description *</label>
                    <textarea id="description" rows="3" required placeholder="Event description..."></textarea>
                </div>
                <div class="form-group">
                    <label>Date & Time *</label>
                    <input type="datetime-local" id="date" required>
                </div>
                <div class="form-group">
                    <label>Location *</label>
                    <input type="text" id="location" required placeholder="Event venue">
                </div>
                <div class="form-group">
                    <label>Total Seats *</label>
                    <input type="number" id="totalSeats" required placeholder="Maximum capacity">
                </div>
                <div class="form-group">
                    <label>Category</label>
                    <select id="category">
                        <option>Workshop</option>
                        <option>Seminar</option>
                        <option>Conference</option>
                        <option>Cultural</option>
                        <option>Sports</option>
                        <option>Technical</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">Create Event</button>
            </form>
        </div>

        <div class="card">
            <h2 class="card-title">📅 All Events</h2>
            <div id="eventsList"></div>
        </div>
    </div>

    <script>
        let allEvents = [];

        document.addEventListener('DOMContentLoaded', () => {
            loadEvents();
        });

        async function loadEvents() {
            try {
                const response = await fetch('/events');
                const data = await response.json();
                if (data.success) {
                    allEvents = data.events;
                    updateStats();
                    displayEvents();
                }
            } catch (error) {
                console.error('Error:', error);
            }
        }

        function updateStats() {
            document.getElementById('totalEvents').innerHTML = allEvents.length;
            const upcoming = allEvents.filter(e => new Date(e.date) > new Date()).length;
            document.getElementById('upcomingEvents').innerHTML = upcoming;
            
            let totalReg = 0;
            allEvents.forEach(e => totalReg += e.registeredStudents?.length || 0);
            document.getElementById('totalRegistrations').innerHTML = totalReg;
        }

        function displayEvents() {
            const container = document.getElementById('eventsList');
            if (allEvents.length === 0) {
                container.innerHTML = '<p>No events created yet. Create your first event above.</p>';
                return;
            }

            container.innerHTML = allEvents.map(event => `
                <div class="event-card">
                    <div class="event-header">
                        <div>
                            <h3>🎪 ${escapeHtml(event.title)}</h3>
                            <p>${escapeHtml(event.description)}</p>
                            <p><strong>📅 Date:</strong> ${new Date(event.date).toLocaleString()}</p>
                            <p><strong>📍 Location:</strong> ${escapeHtml(event.location)}</p>
                            <p><strong>🏷️ Category:</strong> ${event.category || 'General'}</p>
                            <p><strong>👥 Registered Students:</strong> ${event.registeredStudents?.length || 0}</p>
                            <p><strong>🎟️ Seats:</strong> 
                                <span class="seats-info ${event.availableSeats > 0 ? 'seats-available' : 'seats-full'}">
                                    ${event.availableSeats}/${event.totalSeats} available
                                </span>
                            </p>
                        </div>
                        <div>
                            <button class="btn btn-info" style="margin-right: 0.5rem;" onclick="viewRegistrations('${event._id}')">View Registrations</button>
                            <button class="btn btn-danger" onclick="deleteEvent('${event._id}')">Delete</button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        document.getElementById('eventForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const data = {
                title: document.getElementById('title').value,
                description: document.getElementById('description').value,
                date: document.getElementById('date').value,
                location: document.getElementById('location').value,
                totalSeats: document.getElementById('totalSeats').value,
                category: document.getElementById('category').value
            };
            
            try {
                const response = await fetch('/events/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                
                const result = await response.json();
                if (result.success) {
                    alert('Event created successfully!');
                    document.getElementById('eventForm').reset();
                    loadEvents();
                } else {
                    alert('Error: ' + result.message);
                }
            } catch (error) {
                alert('Error: ' + error.message);
            }
        });

        async function deleteEvent(id) {
            if (confirm('Are you sure you want to delete this event? This will remove all registrations.')) {
                alert('Event deleted successfully!');
                loadEvents();
            }
        }

        async function viewRegistrations(eventId) {
            try {
                const response = await fetch(`/events/${eventId}/registrations`);
                const data = await response.json();
                if (data.success && data.registrations.length > 0) {
                    let msg = "Registered Students:\n\n";
                    data.registrations.forEach((reg, i) => {
                        msg += `${i+1}. ${reg.studentName}\n`;
                    });
                    alert(msg);
                } else {
                    alert('No students registered for this event yet.');
                }
            } catch (error) {
                alert('Error loading registrations: ' + error.message);
            }
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function logout() { window.location.href = '/logout'; }
    </script>
</body>
</html>