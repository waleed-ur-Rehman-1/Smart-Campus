        <video autoplay muted loop playsinline preload="auto"
               src="/videos/campus-admin.mp4"
               poster="/images/campus-admin-poster.jpg">
        </video>
        <div class="bg-overlay"></div>
    </div>
    <div class="bg-grain"></div>

    <div class="shell">

        <!-- ═══ SIDEBAR ═══════════════════════════════════ -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-logo">
                <div class="logo-emblem">SC</div>
                <div class="logo-text">
                    <strong>SmartCampus</strong>
                    <small>Control Panel</small>
                </div>
            </div>

            <div class="sidebar-admin">
                <div class="avatar">AD</div>
                <div class="admin-info">
                    <strong>Administrator</strong>
                    <span>Super Admin</span>
                </div>
                <div class="admin-status"></div>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section-label">Overview</div>
                <div class="nav-item active" onclick="window.location.href='/dashboard/admin'">
                    <span class="nav-icon">⬛</span> Dashboard
                </div>
                <div class="nav-item" onclick="window.location.href='/admin/analytics'">
                    <span class="nav-icon">📊</span> Analytics
                </div>

                <div class="nav-section-label">Management</div>
                <div class="nav-item" onclick="window.location.href='/admin/students'">
                    <span class="nav-icon">👥</span> Students
                    <span class="nav-badge gold"><%= typeof totalStudents !== 'undefined' ? totalStudents : '0' %></span>
                </div>
                
                <!-- MANAGEMENT LINKS - ADDED HERE -->
                <div class="nav-section-label" style="margin-top: 0.25rem;">Content Manager</div>
                
                <div class="nav-item" onclick="window.location.href='/admin/announcements'">
                    <span class="nav-icon">📢</span>
                    <span>Manage Announcements</span>
                </div>
                
                <div class="nav-item" onclick="window.location.href='/admin/events'">
                    <span class="nav-icon">🎉</span>
                    <span>Manage Events</span>
                </div>
                
                <div class="nav-item" onclick="window.location.href='/admin/complaints'">
                    <span class="nav-icon">📋</span>
                    <span>Manage Complaints</span>
                    <span class="nav-badge"><%= typeof pendingComplaints !== 'undefined' ? pendingComplaints : '0' %></span>
                </div>
                
                <div class="nav-item" onclick="window.location.href='/admin/fyp'">
                    <span class="nav-icon">📚</span>
                    <span>FYP Projects</span>
                    <span class="nav-badge"><%= typeof pendingFYP !== 'undefined' ? pendingFYP : '0' %></span>
                </div>

                <div class="nav-section-label">System</div>
                <div class="nav-item" onclick="window.location.href='/admin/settings'">
                    <span class="nav-icon">⚙️</span> Settings
                </div>
                <div class="nav-item" onclick="window.location.href='/admin/access'">
                    <span class="nav-icon">🔐</span> Access Control
                </div>
            </nav>

            <div class="sidebar-footer">
                <button class="logout-btn" onclick="logout()">
                    <span>⎋</span> Sign Out
                </button>
            </div>
        </aside>

        <!-- ═══ PAGE WRAP ════════════════════════════════ -->
        <div style="flex:1; display:flex; flex-direction:column;">

            <!-- TOPBAR -->
            <header class="topbar">
                <div class="topbar-title">
                    <h1>Administrator Dashboard</h1>
                    <p>City University of Science &amp; Information Technology</p>
                </div>

                <div class="topbar-right">
                    <div class="topbar-time">
                        <div class="time" id="live-time">--:--</div>
                        <div class="date" id="live-date">---</div>
                    </div>

                    <div class="topbar-divider"></div>

                    <div class="notif-btn" title="Notifications" onclick="showNotifications()">
                        🔔
                        <span class="notif-dot"></span>
                    </div>

                    <div class="notif-btn" title="Messages" onclick="showMessages()">✉️</div>
                </div>
            </header>

            <!-- MAIN -->
            <main class="main">

                <!-- ── STAT CARDS ──────────────────────────── -->
                <div class="stats-row">
                    <div class="stat-card c-gold reveal" data-d="1" onclick="window.location.href='/admin/students'">
                        <span class="stat-icon">👥</span>
                        <div class="stat-val" data-count="<%= typeof totalStudents !== 'undefined' ? totalStudents : 0 %>">0</div>
                        <div class="stat-lbl">Total Students</div>
                        <span class="stat-trend trend-up">+8%</span>
                    </div>
                    <div class="stat-card c-danger reveal" data-d="2" onclick="window.location.href='/admin/complaints?status=Pending'">
                        <span class="stat-icon">📋</span>
                        <div class="stat-val" data-count="<%= typeof pendingComplaints !== 'undefined' ? pendingComplaints : 0 %>">0</div>
                        <div class="stat-lbl">Pending Complaints</div>
                        <span class="stat-trend trend-warn">Active</span>
                    </div>
                    <div class="stat-card c-success reveal" data-d="3" onclick="window.location.href='/admin/events'">
                        <span class="stat-icon">🎉</span>
                        <div class="stat-val" data-count="<%= typeof activeEvents !== 'undefined' ? activeEvents : 0 %>">0</div>
                        <div class="stat-lbl">Active Events</div>
                        <span class="stat-trend trend-up">Live</span>
                    </div>
                    <div class="stat-card c-warn reveal" data-d="4" onclick="window.location.href='/admin/fyp?status=Pending'">
                        <span class="stat-icon">📚</span>
                        <div class="stat-val" data-count="<%= typeof pendingFYP !== 'undefined' ? pendingFYP : 0 %>">0</div>
                        <div class="stat-lbl">FYP Pending</div>
                        <span class="stat-trend trend-warn">Review</span>
                    </div>
                    <div class="stat-card c-info reveal" data-d="5" onclick="window.location.href='/admin/complaints'">
                        <span class="stat-icon">🗂️</span>
                        <div class="stat-val" data-count="<%= typeof totalComplaints !== 'undefined' ? totalComplaints : 0 %>">0</div>
                        <div class="stat-lbl">Total Complaints</div>
                        <span class="stat-trend trend-up">All time</span>
                    </div>
                    <div class="stat-card c-purple reveal" data-d="6" onclick="window.location.href='/admin/events'">
                        <span class="stat-icon">📅</span>
                        <div class="stat-val" data-count="<%= typeof totalEvents !== 'undefined' ? totalEvents : 0 %>">0</div>
                        <div class="stat-lbl">Total Events</div>
                        <span class="stat-trend trend-up">+3</span>
                    </div>
                </div>

                <!-- ── QUICK ACTIONS ──────────────────────── -->
                <div class="panel reveal" style="margin-bottom:1.5rem;">
                    <div class="panel-head">
                        <div class="panel-head-left">
                            <div class="panel-icon">⚡</div>
                            <div>
                                <div class="panel-title">Quick Actions</div>
                                <div class="panel-subtitle">Frequently used operations</div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-body">
                        <div class="quick-actions">
                            <div class="qa-btn" onclick="window.location.href='/admin/announcements'">
                                <span class="qa-icon">➕</span>
                                <span class="qa-label">New Announcement</span>
                            </div>
                            <div class="qa-btn" onclick="window.location.href='/admin/events'">
                                <span class="qa-icon">🎫</span>
                                <span class="qa-label">Create Event</span>
                            </div>
                            <div class="qa-btn" onclick="window.location.href='/admin/complaints'">
                                <span class="qa-icon">📥</span>
                                <span class="qa-label">View Complaints</span>
                            </div>
                            <div class="qa-btn" onclick="exportReport()">
                                <span class="qa-icon">📤</span>
                                <span class="qa-label">Export Report</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ── COMPLAINTS + ACTIVITY ──────────────── -->
                <div class="content-grid">

                    <!-- Complaints Table -->
                    <div class="panel reveal">
                        <div class="panel-head">
                            <div class="panel-head-left">
                                <div class="panel-icon">📋</div>
                                <div>
                                    <div class="panel-title">Recent Complaints</div>
                                    <div class="panel-subtitle">Awaiting your review</div>
                                </div>
                            </div>
                            <button class="panel-action" onclick="window.location.href='/admin/complaints'">View All →</button>
                        </div>
                        <div class="panel-body" style="padding:0;">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Student</th>
                                        <th>Issue</th>
                                        <th>Category</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody id="recentComplaintsTable">
                                    <tr><td colspan="5" style="text-align:center;">Loading complaints...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Activity Feed -->
                    <div class="panel reveal">
                        <div class="panel-head">
                            <div class="panel-head-left">
                                <div class="panel-icon">⚡</div>
                                <div>
                                    <div class="panel-title">Live Activity</div>
                                    <div class="panel-subtitle">Real-time campus events</div>
                                </div>
                            </div>
                            <button class="panel-action" onclick="clearActivities()">Clear</button>
                        </div>
                        <div class="panel-body">
                            <div class="activity-feed" id="activityFeed">
                                <div class="activity-item">
                                    <div class="act-dot-wrap">
                                        <div class="act-dot" style="background:var(--success);box-shadow:0 0 6px var(--success);"></div>
                                        <div class="act-line"></div>
                                    </div>
                                    <div class="act-body">
                                        <div class="act-msg"><strong>System Ready</strong> — Admin dashboard loaded</div>
                                        <div class="act-time">Just now</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- ── EVENTS + ANNOUNCEMENTS ─────────────── -->
                <div class="content-grid">

                    <!-- Events Table -->
                    <div class="panel reveal">
                        <div class="panel-head">
                            <div class="panel-head-left">
                                <div class="panel-icon">🎉</div>
                                <div>
                                    <div class="panel-title">Upcoming Events</div>
                                    <div class="panel-subtitle">Seat occupancy at a glance</div>
                                </div>
                            </div>
                            <button class="panel-action" onclick="window.location.href='/admin/events'">Manage →</button>
                        </div>
                        <div class="panel-body" style="padding:0;">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Event</th>
                                        <th>Date</th>
                                        <th>Venue</th>
                                        <th>Seats</th>
                                    </tr>
                                </thead>
                                <tbody id="upcomingEventsTable">
                                    <tr><td colspan="4" style="text-align:center;">Loading events...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Announcements -->
                    <div class="panel reveal">
                        <div class="panel-head">
                            <div class="panel-head-left">
                                <div class="panel-icon">📢</div>
                                <div>
                                    <div class="panel-title">Recent Announcements</div>
                                    <div class="panel-subtitle">Posted to all students</div>
                                </div>
                            </div>
                            <button class="panel-action" onclick="window.location.href='/admin/announcements'">New +</button>
                        </div>
                        <div class="panel-body">
                            <div class="ann-list" id="announcementsList">
                                <div style="text-align:center; padding:1rem;">Loading announcements...</div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- ── FOOTER BAR ──────────────────────────── -->
                <div style="text-align:center; padding:1.5rem 0 0.5rem; border-top:1px solid var(--card-border); margin-top:0.5rem;">
                    <p style="font-size:0.72rem; color:var(--text-faint); letter-spacing:0.06em;">
                        SmartCampus Admin Panel · City University of Science &amp; Information Technology · Peshawar, KPK
                    </p>
                </div>

            </main>
        </div>
    </div>

    <script>
        // ── Live clock ────────────────────────────────
        function updateClock() {
            const now = new Date();
            const t = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });
            const d = now.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
            document.getElementById('live-time').textContent = t;
            document.getElementById('live-date').textContent = d;
        }
        updateClock();
        setInterval(updateClock, 1000);

        // ── Scroll reveal ─────────────────────────────
        const revealEls = document.querySelectorAll('.reveal');
        const ro = new IntersectionObserver(entries => {
            entries.forEach(e => {
                if (e.isIntersecting) { e.target.classList.add('in'); ro.unobserve(e.target); }
            });
        }, { threshold: 0.08 });
        revealEls.forEach(el => ro.observe(el));

        // ── Counter animation ─────────────────────────
        function runCount(el, target, dur = 1600) {
            let start = null;
            const step = ts => {
                if (!start) start = ts;
                const p = Math.min((ts - start) / dur, 1);
                const eased = 1 - Math.pow(1 - p, 3);
                el.textContent = Math.floor(eased * target).toLocaleString();
                if (p < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
        }

        const countEls = document.querySelectorAll('[data-count]');
        const co = new IntersectionObserver(entries => {
            entries.forEach(e => {
                if (e.isIntersecting) {
                    runCount(e.target, parseInt(e.target.dataset.count, 10));
                    co.unobserve(e.target);
                }
            });
        }, { threshold: 0.5 });
        countEls.forEach(el => co.observe(el));

        // ── Seat bars animate on scroll ───────────────
        const seatFills = document.querySelectorAll('.seat-fill');
        const so = new IntersectionObserver(entries => {
            entries.forEach(e => {
                if (e.isIntersecting) {
                    const w = e.target.style.width;
                    e.target.style.width = '0';
                    setTimeout(() => { e.target.style.width = w; }, 100);
                    so.unobserve(e.target);
                }
            });
        }, { threshold: 0.5 });
        seatFills.forEach(el => so.observe(el));

        // ── Load Data from API ────────────────────────
        async function loadDashboardData() {
            try {
                // Load complaints
                const complaintsRes = await fetch('/complaints/all');
                const complaintsData = await complaintsRes.json();
                if (complaintsData.success) {
                    displayRecentComplaints(complaintsData.complaints.slice(0, 5));
                }

                // Load events
                const eventsRes = await fetch('/events');
                const eventsData = await eventsRes.json();
                if (eventsData.success) {
                    displayUpcomingEvents(eventsData.events.slice(0, 4));
                }

                // Load announcements
                const annRes = await fetch('/announcements');
                const annData = await annRes.json();
                if (annData.success) {
                    displayAnnouncements(annData.announcements.slice(0, 3));
                }

                // Add activity log
                addActivityLog('Dashboard data loaded successfully', 'success');
            } catch (error) {
                console.error('Error loading dashboard data:', error);
                addActivityLog('Error loading dashboard data', 'danger');
            }
        }

        function displayRecentComplaints(complaints) {
            const tbody = document.getElementById('recentComplaintsTable');
            if (!complaints || complaints.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;">No complaints found</td></tr>';
                return;
            }

            tbody.innerHTML = complaints.map(c => `
                <tr>
                    <td>
                        <div class="name-cell">
                            <div class="mini-avatar">${c.studentName ? c.studentName.charAt(0).toUpperCase() : 'S'}</div>
                            ${c.studentName || 'Unknown'}
                        </div>
                    </td>
                    <td style="max-width:140px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">${escapeHtml(c.title)}</td>
                    <td><span class="badge badge-gold">${c.category}</span></td>
                    <td>
                        <span class="badge ${c.status === 'Pending' ? 'badge-pending' : c.status === 'Resolved' ? 'badge-resolved' : 'badge-inprog'}">
                            ${c.status}
                        </span>
                    </td>
                    <td><button class="act-btn act-view" onclick="viewComplaint('${c._id}')">View</button></td>
                </tr>
            `).join('');
        }

        function displayUpcomingEvents(events) {
            const tbody = document.getElementById('upcomingEventsTable');
            if (!events || events.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;">No upcoming events</td></tr>';
                return;
            }

            tbody.innerHTML = events.map(e => {
                const fillPercent = ((e.totalSeats - e.availableSeats) / e.totalSeats) * 100;
                return `
                    <tr>
                        <td><strong>${escapeHtml(e.title)}</strong></td>
                        <td>${new Date(e.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}</td>
                        <td>${escapeHtml(e.location)}</td>
                        <td>
                            <div class="seat-bar">
                                <div class="seat-track">
                                    <div class="seat-fill" style="width: ${fillPercent}%"></div>
                                </div>
                                <span class="seat-text">${e.availableSeats}/${e.totalSeats}</span>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function displayAnnouncements(announcements) {
            const container = document.getElementById('announcementsList');
            if (!announcements || announcements.length === 0) {
                container.innerHTML = '<div style="text-align:center; padding:1rem;">No announcements available</div>';
                return;
            }

            container.innerHTML = announcements.map(a => {
                const d = new Date(a.createdAt);
                return `
                    <div class="ann-item">
                        <div class="ann-date-block">
                            <div class="ann-day">${d.getDate()}</div>
                            <div class="ann-month">${d.toLocaleString('default', { month: 'short' })}</div>
                        </div>
                        <div class="ann-divider"></div>
                        <div class="ann-content">
                            <strong>${escapeHtml(a.title)}</strong>
                            <p>${escapeHtml(a.content.substring(0, 90))}...</p>
                        </div>
                    </div>
                `;
            }).join('');
        }

        let activityLogs = [];

        function addActivityLog(message, type = 'info') {
            const feed = document.getElementById('activityFeed');
            const colors = {
                success: 'var(--success)',
                danger: 'var(--danger)',
                warning: 'var(--warning)',
                info: 'var(--gold)'
            };
            
            const newItem = document.createElement('div');
            newItem.className = 'activity-item';
            newItem.innerHTML = `
                <div class="act-dot-wrap">
                    <div class="act-dot" style="background: ${colors[type] || colors.info};"></div>
                    <div class="act-line"></div>
                </div>
                <div class="act-body">
                    <div class="act-msg">${message}</div>
                    <div class="act-time">Just now</div>
                </div>
            `;
            
            feed.insertBefore(newItem, feed.firstChild);
            
            // Remove old activities (keep last 10)
            while (feed.children.length > 10) {
                feed.removeChild(feed.lastChild);
            }
        }

        function clearActivities() {
            const feed = document.getElementById('activityFeed');
            feed.innerHTML = `
                <div class="activity-item">
                    <div class="act-dot-wrap">
                        <div class="act-dot" style="background:var(--success);"></div>
                        <div class="act-line"></div>
                    </div>
                    <div class="act-body">
                        <div class="act-msg"><strong>Activity cleared</strong> — Log reset</div>
                        <div class="act-time">Just now</div>
                    </div>
                </div>
            `;
            addActivityLog('Activity log cleared', 'warning');
        }

        function viewComplaint(id) {
            window.location.href = '/admin/complaints?view=' + id;
        }

        function showNotifications() {
            alert('📢 Notifications\n\n- 3 new complaints pending\n- 2 events ending soon\n- 5 students registered today');
        }

        function showMessages() {
            alert('✉️ Messages\n\nNo new messages from students.');
        }

        function exportReport() {
            window.location.href = '/admin/export-report';
        }

        function logout() {
            if (confirm('Sign out of SmartCampus Admin?')) {
                window.location.href = '/logout';
            }
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function showToast(message, type) {
            const toast = document.createElement('div');
            toast.className = 'toast';
            toast.style.background = type === 'success' ? '#2ecc82' : type === 'error' ? '#e05c5c' : '#f0a845';
            toast.textContent = message;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }

        // Load data on page load
        document.addEventListener('DOMContentLoaded', () => {
            loadDashboardData();
            setInterval(() => {
                addActivityLog('Auto-refresh: System status OK', 'success');
            }, 30000);
        });

        // Stat card hover glow effect
        document.querySelectorAll('.stat-card').forEach(card => {
            card.addEventListener('mousemove', e => {
                const r = card.getBoundingClientRect();
                const x = ((e.clientX - r.left) / r.width) * 100;
                const y = ((e.clientY - r.top) / r.height) * 100;
                card.style.setProperty('--mx', x + '%');
                card.style.setProperty('--my', y + '%');
            });
        });
    </script>
</body>
</html>